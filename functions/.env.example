# Non-secret Cloud Functions configuration. Copy to functions/.env (or functions/.env.<projectId>).
# Secrets (SEMAPHORE_API_KEY) are set with:
#   firebase functions:secrets:set SEMAPHORE_API_KEY
# For the emulator, put secret values in functions/.secret.local (gitignored).

# Public base URL of the Vercel deployment. Hospital links are built as <APP_BASE_URL>/referral/<token>.
APP_BASE_URL=http://localhost:5173

# Referral link lifetime in hours (24–72 for the MVP).
REFERRAL_LINK_TTL_HOURS=48

# AI summary provider. Only "mock" exists for now; the Amazon Q provider is added later behind the same SummaryProvider interface.
AI_PROVIDER=mock

# SMS provider: "mock" (logs only) or "semaphore".
SMS_PROVIDER=mock
SEMAPHORE_SENDER_NAME=MARA

# "true" makes callable functions reject requests without a valid App Check token.
ENFORCE_APP_CHECK=false

# Max getReferralView/status requests per client IP per minute.
REFERRAL_RATE_LIMIT_PER_MINUTE=30
