# Frontend (Vite) configuration — copy to .env.local for local dev.
# These values are public Firebase web config, not secrets. Set the same keys in Vercel → Project → Environment Variables.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mara.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-mara
VITE_FIREBASE_STORAGE_BUCKET=demo-mara.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Optional: absolute origin of the MARA API. Leave empty: the app calls /api on the same domain
# (Vercel in production, scripts/dev-api.ts via the Vite proxy in development).
VITE_API_BASE_URL=

# "true" connects to the local Firebase Emulator Suite (auth 9099, firestore 8080).
# Local development only. NEVER set this to true in Vercel.
VITE_USE_EMULATORS=true

# Optional: reCAPTCHA Enterprise site key for Firebase App Check. Leave empty to disable App Check on the client.
VITE_APPCHECK_SITE_KEY=

# Idle session timeout in minutes.
VITE_SESSION_TIMEOUT_MINUTES=30
