{
  "name": "mara",
  "private": true,
  "version": "0.1.0",
  "description": "MARA — Maternal Referral and Admission. The patient moves. Her record moves with her.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "esbuild functions/src/http/index.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=server-dist/index.cjs --log-level=warning",
    "build:vercel": "npm run build && npm run build:server",
    "dev:api": "tsx scripts/dev-api.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && npm --prefix functions run build",
    "lint": "eslint .",
    "build:functions": "npm --prefix functions run build",
    "test": "vitest --run",
    "test:rules": "firebase emulators:exec --only firestore \"vitest --run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "@vercel/functions": "3.9.11",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "firebase-tools": "15.32.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1"
  }
}
